<group name="windows, sysmon, custom_threat_hunt,">
<rule id="100001" level="12">
<if_group>sysmon_event1</if_group>
<match>powershell.exe</match>
<regex>-ExecutionPolicy Bypass|-ep bypass|-WindowStyle Hidden|-w hidden|-EncodedCommand|-e </regex>
<description>suspicious Powershell Execution: Potential Fileless Malware Evasion Techniques</description>
<mitre>
<id>T1059.001</id>
</mitre>
</rule>
</group>
